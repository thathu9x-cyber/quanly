rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Kiểm tra kết nối máy chủ (Connection test)
    match /_connection_test/{docId} {
      allow read, write: if true;
    }
    match /test/{docId} {
      allow read, write: if true;
    }

    // Danh mục sản phẩm (Products)
    match /products/{productId} {
      allow read: if true;
      allow write: if isValidId(productId);
    }

    // Phiếu nhập kho (Imports)
    match /imports/{importId} {
      allow read: if true;
      allow write: if isValidId(importId);
    }

    // Phiếu xuất kho (Exports)
    match /exports/{exportId} {
      allow read: if true;
      allow write: if isValidId(exportId);
    }

    // Báo cáo tháng (Monthly Reports)
    match /monthly_reports/{reportId} {
      allow read: if true;
      allow write: if isValidId(reportId);
    }

    // Tài khoản mã PIN (Pin Accounts)
    match /pin_accounts/{accountId} {
      allow read: if true;
      allow write: if isValidId(accountId);
    }

    // Lịch sử thao tác (Audit Logs)
    match /audit_logs/{logId} {
      allow read: if true;
      allow write: if isValidId(logId);
    }
  }
}
